---
const { heading, sub, ctaLabel, ctaHref, colors } = Astro.props;
---
<section class="hero" style={`--primary:${colors.primary};--accent:${colors.accent}`}><h1>{heading}</h1><p>{sub}</p>{ctaLabel && <a class="cta" href={ctaHref}>{ctaLabel}</a>}</section>
<style>.hero{padding:6rem 1.5rem;text-align:center}.hero h1{font-size:clamp(2rem,5vw,3.5rem);color:var(--primary)}.cta{display:inline-block;margin-top:1.5rem;padding:.85rem 1.6rem;border-radius:.6rem;background:var(--accent);color:#fff;text-decoration:none;font-weight:600}</style>
