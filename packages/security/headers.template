# Cloudflare Pages headers → each client's public/_headers. Add a CSP origin only (never wildcard).
# NOTE: script-src/style-src allow 'unsafe-inline' because SiteWright native add-ons (chatbot, live-chat,
# forms) are self-contained inline HTML/CSS/JS by design. Sites are static (no user-generated content), so
# inline-script risk is minimal; keep everything else locked down.
/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; frame-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
