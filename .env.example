# Copy to .env (already gitignored — never commit real keys). See SETUP.md.

# Cloudflare Pages deploy (scripts/deploy.mjs, .github/workflows/deploy.yml)
CLOUDFLARE_API_TOKEN=

# /find-leads (packages/prospecting) — Google Cloud key with "Places API (New)" enabled
GOOGLE_PLACES_API_KEY=

# /audit-site + speed numbers in /find-opportunities (packages/audit) — optional, works without it
PAGESPEED_API_KEY=

# Command Center login (npm run command-center) — pick any password, required to sign in
COMMAND_CENTER_PASSWORD=

# Command Center port (optional, defaults to 4700)
COMMAND_CENTER_PORT=
