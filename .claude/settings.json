{ "$comment":"Hooks deterministic.","permissions":{"deny":["Bash(rm -rf /*)","Read(./.env)","Read(./clients/**/.env)"],"ask":["Bash(git push:*)","Bash(npx wrangler pages deploy:*)"]},
  "hooks":{"PreToolUse":[{"matcher":"Bash","hooks":[{"type":"command","command":"grep -qE 'rm -rf (/|~|\\.\\.)|:\\(\\)\\{|mkfs|dd if=' && { echo blocked >&2; exit 2; } || exit 0"}]},{"matcher":"Write|Edit","hooks":[{"type":"command","command":"bash .claude/hooks/no-secrets-guard.sh"}]}],"PostToolUse":[{"matcher":"Write|Edit","hooks":[{"type":"command","command":"bash .claude/hooks/secret-scan.sh"}]}],"PreCompact":[{"hooks":[{"type":"command","command":"bash .claude/hooks/flush-memory.sh"}]}]} }
